{
  "name": "monitoring-anything",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:python": "python -m pytest -q -p no:cacheprovider collector/tools/tests",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "python:fetch": "node scripts/fetch-python.mjs",
    "demo:connect": "python scripts/demo-connect.py",
    "demo:media": "node scripts/demo-media.mjs",
    "demo:gifs": "python scripts/demo-gifs.py",
    "package:macos": "node scripts/macos-package.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "jsdom": "^30.1.2",
    "playwright-core": "1.63.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.3"
  },
  "description": "Research progress dashboard: projects, milestones, monitored LaTeX papers and simulation runs, floating widget",
  "license": "GPL-3.0-only"
}
